rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / ROLE HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function realUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Current TUBAL HUB admin account.
    // Long-term, migrate this to a Firebase custom admin claim.
    function adminUser() {
      return realUser()
        && request.auth.token.email == 'tubalrr@gmail.com';
    }

    function ownsNew() {
      return realUser()
        && request.resource.data.uid == request.auth.uid;
    }

    function ownsExisting() {
      return realUser()
        && resource.data.uid == request.auth.uid;
    }

    // =========================================================
    // CHAT STATUS / TIMED BAN
    // =========================================================

    function chatAllowed() {
      let u = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      return realUser()
        && (
          !('chatStatus' in u)
          || u.chatStatus == 'active'
          || (
            u.chatStatus == 'banned'
            && 'banUntil' in u
            && u.banUntil != null
            && u.banUntil <= request.time
          )
        )
        && (
          !('mutedUntil' in u)
          || u.mutedUntil == null
          || u.mutedUntil <= request.time
        );
    }

    // =========================================================
    // GLOBAL CHAT
    // =========================================================

    match /globalChats/{messageId} {
      allow read: if chatAllowed();

      allow create: if chatAllowed()
        && ownsNew()
        && request.resource.data.channel in ['global-chat', 'payapang-isip', 'ctrlzone', 'shop-talk', 'announcements']
        && request.resource.data.type in ['text', 'image', 'gif']
        && !('isAdmin' in request.resource.data)
        && !('roleReal' in request.resource.data)
        && (
          request.resource.data.type != 'text'
          || (
            request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
          )
        )
        && (
          request.resource.data.type == 'text'
          || request.resource.data.mediaUrl is string
        );

      allow update: if (
        chatAllowed()
        && ownsExisting()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.channel == resource.data.channel
        && request.resource.data.type == resource.data.type
      ) || adminUser();

      allow delete: if ownsExisting() || adminUser();
    }

    // =========================================================
    // GLOBAL CHAT REPLIES
    // =========================================================

    match /globalChatReplies/{replyId} {
      allow read: if chatAllowed();

      allow create: if chatAllowed()
        && ownsNew()
        && request.resource.data.messageId is string
        && request.resource.data.uid == request.auth.uid
        && !('isAdmin' in request.resource.data)
        && !('roleReal' in request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow update: if (
        chatAllowed()
        && ownsExisting()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.messageId == resource.data.messageId
      ) || adminUser();

      allow delete: if ownsExisting() || adminUser();
    }

    // =========================================================
    // GLOBAL CHAT REACTIONS
    // =========================================================

    match /globalChatReactions/{reactionId} {
      allow read: if chatAllowed();

      allow create: if chatAllowed()
        && ownsNew()
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.messageId is string
          || request.resource.data.replyId is string
        )
        && request.resource.data.reactions is list
        && request.resource.data.reactions.size() <= 10;

      allow update: if (
        chatAllowed()
        && ownsExisting()
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.messageId == resource.data.messageId
          || request.resource.data.replyId == resource.data.replyId
        )
        && request.resource.data.reactions is list
        && request.resource.data.reactions.size() <= 10
      ) || adminUser();

      allow delete: if ownsExisting() || adminUser();
    }

    // =========================================================
    // PRESENCE
    // =========================================================

    match /presence/{userId} {
      allow read: if realUser();

      allow create, update: if realUser()
        && userId == request.auth.uid;

      allow delete: if realUser()
        && userId == request.auth.uid;
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {
      allow read: if realUser();

      allow create: if realUser()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow update: if adminUser()
        || (
          realUser()
          && userId == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasNone([
            'chatStatus',
            'warnings',
            'mutedUntil',
            'banReason',
            'moderatedBy',
            'moderatedAt',
            'banned',
            'bannedAt',
            'bannedBy',
            'banUntil'
          ])
        );

      allow delete: if realUser()
        && userId == request.auth.uid;
    }

    // =========================================================
    // ADMIN GLOBAL CHAT
    // =========================================================

    match /globalChat/{messageId} {
      allow read, delete: if adminUser();
      allow create, update: if false;
    }

    // =========================================================
    // ADMIN QUOTES
    // =========================================================

    match /adminQuotes/{quoteId} {
      allow read, write: if adminUser();
    }

    // =========================================================
    // PRIVATE MESSAGES
    // =========================================================

    match /messages/{messageId} {
      allow read: if realUser()
        && (
          adminUser()
          || request.auth.uid in resource.data.participants
        );

      allow create: if realUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.type == 'text';

      allow update: if realUser()
        && (
          adminUser()
          || (
            resource.data.uid == request.auth.uid
            && resource.data.senderId == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.receiverId == resource.data.receiverId
            && request.resource.data.participants == resource.data.participants
          )
        );

      // SECURITY FIX: delete uses resource.data, not request.resource.data.
      allow delete: if realUser()
        && (
          adminUser()
          || (
            resource.data.uid == request.auth.uid
            && resource.data.senderId == request.auth.uid
          )
        );
    }

    // =========================================================
    // VIDEO CALLS
    // =========================================================

    match /videoCalls/{callId} {
      allow create: if realUser()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing';

      allow read: if realUser()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      allow update: if realUser()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;

      allow delete: if realUser()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      match /candidates/{candidateId} {
        allow read: if realUser()
          && (
            get(/databases/$(database)/documents/videoCalls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/videoCalls/$(callId)).data.calleeId == request.auth.uid
          );

        allow create: if realUser()
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/videoCalls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/videoCalls/$(callId)).data.calleeId == request.auth.uid
          );

        allow delete: if realUser()
          && (
            get(/databases/$(database)/documents/videoCalls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/videoCalls/$(callId)).data.calleeId == request.auth.uid
          );
      }
    }

    // =========================================================
    // UNIFIED HUB CONTENT FEED
    // =========================================================
    // One publish can surface in the appropriate TUBAL HUB areas:
    // Feeds plus the source section such as News, Shop, Games, etc.
    match /hubPosts/{postId} {
      allow read: if true;

      allow create: if realUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.contentType in [
          'post','product','game','news','video','announcement','event','story'
        ]
        && request.resource.data.status == 'published'
        && request.resource.data.destinations is list
        && request.resource.data.destinations.size() > 0
        && request.resource.data.destinations.size() <= 10
        && request.resource.data.title is string
        && request.resource.data.text is string
        && request.resource.data.title.size() <= 240
        && request.resource.data.text.size() <= 4000;

      allow update, delete: if adminUser()
        || (
          realUser()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
        );
    }

    // =========================================================
    // PUBLIC CONTENT — ADMIN WRITE
    // =========================================================

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if adminUser();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if adminUser();
    }

    match /facebookVideos/{videoId} {
      allow read: if true;

      allow create: if adminUser()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() <= 2000
        && (
          !('thumbnail' in request.resource.data)
          || request.resource.data.thumbnail is string
        )
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if adminUser()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() <= 2000;

      allow delete: if adminUser();
    }

    // =========================================================
    // SHOP PRODUCTS — ADMIN WRITE
    // =========================================================

    match /products/{productId} {
      allow read: if true;

      allow create: if adminUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.category in ['mods', 'products', 'music']
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('badge', '') is string
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('productUrl', '') is string;

      allow update: if adminUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.category in ['mods', 'products', 'music']
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('badge', '') is string
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('productUrl', '') is string;

      allow delete: if adminUser();
    }

    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {
      allow read: if realUser()
        && resource.data.recipientUid == request.auth.uid;

      // Notification writers are restricted to the admin/backend path.
      allow create: if adminUser()
        && request.resource.data.recipientUid is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 240;

      allow update: if adminUser()
        || (
          realUser()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientUid == resource.data.recipientUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read',
            'readAt'
          ])
        );

      allow delete: if adminUser()
        || (
          realUser()
          && resource.data.recipientUid == request.auth.uid
        );
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
