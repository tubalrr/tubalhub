    // =========================================================
    // SHOP PRODUCTS — ADMIN WRITE
    // =========================================================

    match /products/{productId} {
      allow read: if true;

      allow create: if adminUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.category in ['merchandise', 'clothing', 'accessories', 'digital-products', 'apps-software', 'gaming', 'mods-addons', 'media', 'wellness', 'coffee', 'other']
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('badge', '') is string
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('productUrl', '') is string
        && request.resource.data.get('sourceType', 'admin-managed') in ['admin-managed', 'external', 'demo']
        && request.resource.data.get('catalogStatus', 'live') in ['live', 'draft', 'hidden', 'archived']
        && request.resource.data.get('isVisible', true) is bool
        && request.resource.data.get('productType', 'physical') is string
        && (
          request.resource.data.get('productType', 'physical') != 'physical'
          || (
            'stock' in request.resource.data
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
          )
        )
        && (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool)
        && (request.resource.data.category != 'coffee' || request.resource.data.get('brandKey', '') == 'kapeng')
        && !('downloadUrl' in request.resource.data);

      allow update: if adminUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.category in ['merchandise', 'clothing', 'accessories', 'digital-products', 'apps-software', 'gaming', 'mods-addons', 'media', 'wellness', 'coffee', 'other']
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('badge', '') is string
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('productUrl', '') is string
        && request.resource.data.get('sourceType', 'admin-managed') in ['admin-managed', 'external', 'demo']
        && request.resource.data.get('catalogStatus', 'live') in ['live', 'draft', 'hidden', 'archived']
        && request.resource.data.get('isVisible', true) is bool
        && request.resource.data.get('productType', 'physical') is string
        && (
          request.resource.data.get('productType', 'physical') != 'physical'
          || (
            'stock' in request.resource.data
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
          )
        )
        && (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool)
        && (request.resource.data.category != 'coffee' || request.resource.data.get('brandKey', '') == 'kapeng')
        && !('downloadUrl' in request.resource.data);

      allow delete: if adminUser();
    }

    match /productSecrets/{productId} {
      // Actual download source/path is never public.
      allow read, write: if adminUser();
    }

    match /shopRateLimits/{userId} {
      // Rate-limit state is maintained by trusted server code.
      allow read, write: if adminUser();
    }

    // =========================================================
    // SHOP ORDERS / DIGITAL OWNERSHIP / VERSIONS
    // =========================================================

    match /productVersions/{versionId} {
      allow read: if true;
      allow create, update, delete: if adminUser()
        && !('downloadUrl' in request.resource.data);
    }