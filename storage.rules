rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function realUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function adminUser() {
      return realUser()
        && (
          request.auth.token.admin == true
          || request.auth.token.email == 'tubalrr@gmail.com'
        );
    }

    // Existing Global Chat media uploads: max 8 MB and image-only MIME types.
    // Paid digital products are server-delivered through short-lived signed URLs.
    // Direct client reads/writes are blocked on this prefix.
    match /shop-downloads/{allPaths=**} {
      allow read, write: if false;
    }

    match /global-chat/{userId}/{fileName} {
      allow read: if realUser() && (request.auth.uid == userId || adminUser());

      allow create: if realUser()
        && request.auth.uid == userId
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif'
        ];

      allow update: if false;

      allow delete: if realUser()
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
